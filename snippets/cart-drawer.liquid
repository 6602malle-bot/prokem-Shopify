{%- comment -%} Slide-in cart drawer. Contents are populated entirely via JS (cart.js AJAX API) so it always reflects the live cart, including after quick-add or the product form. {%- endcomment -%}
{%- liquid
  assign show_ship_bar = false
  if settings.free_shipping_threshold != blank and settings.free_shipping_threshold > 0
    assign show_ship_bar = true
    assign threshold_cents = settings.free_shipping_threshold | times: 100
  endif
-%}
<div class="cart-drawer" id="CartDrawer" data-cart-drawer hidden{% if show_ship_bar %} data-threshold="{{ threshold_cents }}"{% endif %}
  data-remaining-template="{{ 'cart.free_shipping_left' | t: amount: '§AMOUNT§' | escape }}"
  data-reached-text="{{ 'cart.free_shipping_reached' | t | escape }}">
  <div class="cart-drawer__scrim" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.drawer_title' | t }}">
    <div class="cart-drawer__head">
      <span class="cart-drawer__title">{{ 'cart.drawer_title' | t }}</span>
      <button type="button" class="icon-btn" aria-label="{{ 'general.close' | t }}" data-cart-close>{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="cart-drawer__body" data-cart-drawer-body>
      <p class="cart-drawer__empty" data-cart-drawer-empty>{{ 'cart.empty' | t }}</p>
      <div class="ship-bar" data-cart-drawer-shipbar hidden>
        <p data-cart-drawer-ship-text></p>
        <div class="ship-bar__track"><div class="ship-bar__fill" data-cart-drawer-ship-fill></div></div>
      </div>
      <ul class="cart-drawer__items" data-cart-drawer-items></ul>
    </div>
    <div class="cart-drawer__foot" data-cart-drawer-foot hidden>
      <div class="cart-drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <strong data-cart-drawer-subtotal></strong>
      </div>
      <p class="cart__note">{{ 'cart.shipping_note' | t }}</p>
      <a class="btn btn--block" href="{{ routes.cart_url }}" data-cart-drawer-checkout>{{ 'cart.checkout' | t }}</a>
      <a class="link-arrow cart-drawer__view" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
    </div>
  </div>
</div>
