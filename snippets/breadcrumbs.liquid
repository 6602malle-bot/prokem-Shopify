{%- comment -%}
  Renders a breadcrumb trail + matching JSON-LD, driven by request.page_type.
  Controlled globally by Theme settings → Layout → "Show breadcrumbs".
{%- endcomment -%}
{%- liquid
  assign show = settings.show_breadcrumbs
  assign parent_title = blank
  assign parent_url = blank
  assign current_title = blank

  case request.page_type
    when 'product'
      if collection.url
        assign parent_title = collection.title
        assign parent_url = collection.url
      elsif product.collections.first
        assign parent_title = product.collections.first.title
        assign parent_url = product.collections.first.url
      endif
      assign current_title = product.title
    when 'collection'
      assign current_title = collection.title
    when 'page'
      assign current_title = page.title
    when 'blog'
      assign current_title = blog.title
    when 'article'
      assign parent_title = blog.title
      assign parent_url = blog.url
      assign current_title = article.title
    when 'search'
      assign current_title = 'search.title' | t
    when 'list-collections'
      assign current_title = 'collection.all_collections' | t
    else
      assign show = false
  endcase
-%}
{%- if show and current_title != blank -%}
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
    <ol class="breadcrumb__list">
      <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumb_home' | t }}</a></li>
      {%- if parent_title != blank -%}
        <li>
          {%- if parent_url != blank -%}<a href="{{ parent_url }}">{{ parent_title }}</a>{%- else -%}<span>{{ parent_title }}</span>{%- endif -%}
        </li>
      {%- endif -%}
      <li aria-current="page"><span>{{ current_title }}</span></li>
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumb_home' | t | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
      {%- if parent_title != blank -%}
      , { "@type": "ListItem", "position": 2, "name": {{ parent_title | json }}{% if parent_url != blank %}, "item": {{ shop.url | append: parent_url | json }}{% endif %} }
      {%- endif -%}
      , { "@type": "ListItem", "position": {% if parent_title != blank %}3{% else %}2{% endif %}, "name": {{ current_title | json }} }
    ]
  }
  </script>
{%- endif -%}
