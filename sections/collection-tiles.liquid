{%- liquid
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif
-%}
<section class="section tiles tiles--{{ section.settings.style }}"{% if is_carousel %} data-carousel style="--per: {{ section.settings.columns }}"{% endif %}>
  <div class="page-width">
    {%- if is_carousel -%}
      <div class="section__head carousel__head">
        <div class="carousel__titles">
          {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        <div class="carousel__controls">
          <div class="carousel__nav">
            <button type="button" class="carousel__btn" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 20 %}</button>
            <button type="button" class="carousel__btn" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', size: 20 %}</button>
          </div>
        </div>
      </div>

      <div class="carousel" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.heading | default: 'general.carousel_label' | t | escape }}">
        <ul class="carousel__track" data-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign col = block.settings.collection
              assign tile_title = block.settings.title | default: col.title
              assign tile_url = col.url | default: block.settings.link | default: '#'
              assign tile_img = block.settings.image | default: col.featured_image
            -%}
            <li class="carousel__item">
              {%- if block.type == '@app' -%}
                {% render block %}
              {%- else -%}
              <a class="tile" href="{{ tile_url }}" {{ block.shopify_attributes }}>
                <span class="tile__media">
                  {%- if tile_img != blank -%}
                    {{ tile_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', sizes: '(min-width: 990px) 20vw, 46vw', alt: tile_title }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                  {%- endif -%}
                </span>
                <span class="tile__title">{{ tile_title }}</span>
              </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      {%- if section.settings.heading != blank -%}
        <div class="section__head"><h2 class="section__title">{{ section.settings.heading }}</h2></div>
      {%- endif -%}
      <div class="grid" style="--cols-d: {{ section.settings.columns }}; --cols-m: {{ section.settings.columns_mobile }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign tile_title = block.settings.title | default: col.title
            assign tile_url = col.url | default: block.settings.link | default: '#'
            assign tile_img = block.settings.image | default: col.featured_image
          -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- else -%}
          <a class="tile" href="{{ tile_url }}" {{ block.shopify_attributes }}>
            <span class="tile__media">
              {%- if tile_img != blank -%}
                {{ tile_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', sizes: '(min-width: 990px) 20vw, 46vw', alt: tile_title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="tile__title">{{ tile_title }}</span>
          </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Utvalda kategorier" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "carousel", "label": "Carousel" }
    ]},
    { "type": "select", "id": "style", "label": "Style", "default": "card", "options": [
      { "value": "card", "label": "Cards" },
      { "value": "round", "label": "Round images" }
    ]},
    { "type": "range", "id": "columns", "label": "Columns / items visible on desktop", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Columns on mobile", "info": "Only used with grid layout. The carousel scrolls freely on mobile.", "min": 1, "max": 3, "step": 1, "default": 2 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Used if no collection is selected." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
