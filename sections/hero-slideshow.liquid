<section class="hero hero--{{ section.settings.height }}{% if section.settings.behind_header %} hero--behind-header{% endif %}" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval }}" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        if forloop.first
          assign loading = 'eager'
        else
          assign loading = 'lazy'
        endif
      -%}
      <div class="slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        {%- if block.type == '@app' -%}
          {% render block %}
        {%- else -%}
        {%- if block.settings.image != blank -%}
          <picture>
            {%- if block.settings.image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
            {%- endif -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: loading: loading, widths: '900, 1400, 1800, 2400', sizes: '100vw', alt: block.settings.image.alt | default: block.settings.heading }}
          </picture>
        {%- else -%}
          <div class="slide__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endif -%}
        <div class="slide__scrim" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
        <div class="page-width slide__content slide__content--v-{{ block.settings.position | default: 'center' }} slide__content--h-{{ block.settings.align | default: 'left' }}">
          <div class="slide__text">
            {%- if block.settings.heading != blank -%}
              <h2 class="slide__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="slide__sub">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-dot aria-label="{{ 'general.slide' | t: n: forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Kampanjer" },
    { "type": "select", "id": "height", "label": "Height", "default": "medium", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" }
    ]},
    { "type": "range", "id": "overlay", "label": "Image overlay (%)", "min": 0, "max": 80, "step": 5, "default": 35 },
    { "type": "checkbox", "id": "behind_header", "label": "Render behind header", "info": "Lets the image reach all the way to the top, with the header floating on top of it. Combine with a transparent header (in the Header section) for a full overlay effect.", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "Recommended 2400 x 900 px." },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Recommended 1000 x 1250 px." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Hösttvättpaket – spara 10%" },
        { "type": "text", "id": "text", "label": "Subheading" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Till paketen" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "position", "label": "Text position (vertical)", "default": "center", "options": [
          { "value": "top", "label": "Topp" },
          { "value": "center", "label": "Mitten" },
          { "value": "bottom", "label": "Botten" }
        ]},
        { "type": "select", "id": "align", "label": "Text alignment (horizontal)", "default": "left", "options": [
          { "value": "left", "label": "Vänster" },
          { "value": "center", "label": "Centrerad" },
          { "value": "right", "label": "Höger" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
