<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', width: 160, alt: shop.name, class: 'footer__logo' }}
        {%- else -%}
          <p class="footer__name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.app_text != blank -%}
          <div class="footer__app">
            <p>{{ section.settings.app_text }}</p>
            {%- if section.settings.app_link != blank -%}
              <a class="btn btn--light" href="{{ section.settings.app_link }}">{{ section.settings.app_button }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'contact' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
              <ul class="footer__social">
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a></li>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
                {%- if settings.social_linkedin != blank -%}<li><a href="{{ settings.social_linkedin }}" rel="noopener" target="_blank">LinkedIn</a></li>{%- endif -%}
                {%- if settings.social_snapchat != blank -%}<li><a href="{{ settings.social_snapchat }}" rel="noopener" target="_blank">Snapchat</a></li>{%- endif -%}
              </ul>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.motto != blank -%}
      <p class="footer__motto">{{ section.settings.motto }}</p>
    {%- endif -%}

    <div class="footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "app_text", "label": "App promo text", "default": "Exklusiva tävlingar, spel och nyheter – ladda ner vår app" },
    { "type": "text", "id": "app_button", "label": "App button label", "default": "Hämta" },
    { "type": "url", "id": "app_link", "label": "App button link" },
    { "type": "text", "id": "motto", "label": "Large motto", "default": "May the gloss be with you ®" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sortiment" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact & social",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>info@example.com<br>08-00 00 00</p>" }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
