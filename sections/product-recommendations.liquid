{%- liquid
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif
-%}
<div class="section{% if is_carousel %} carousel-section{% endif %}" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"{% if is_carousel %} data-carousel style="--per: {{ section.settings.per_row }}"{% endif %}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      {%- if is_carousel -%}
        <div class="section__head carousel__head">
          <div class="carousel__titles"><h2 class="section__title">{{ section.settings.heading }}</h2></div>
          <div class="carousel__controls">
            <div class="carousel__nav">
              <button type="button" class="carousel__btn" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 20 %}</button>
              <button type="button" class="carousel__btn" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', size: 20 %}</button>
            </div>
          </div>
        </div>
        <div class="carousel" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
          <ul class="carousel__track" data-track>
            {%- for recommended in recommendations.products -%}
              <li class="carousel__item">
                {% render 'product-card', card_product: recommended, quick_add: section.settings.show_quick_add, show_rating: section.settings.show_rating, discount_badge: section.settings.show_discount %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <div class="section__head"><h2 class="section__title">{{ section.settings.heading }}</h2></div>
        <div class="grid" style="--cols-d: {{ section.settings.per_row }}; --cols-m: 2">
          {%- for recommended in recommendations.products -%}
            {% render 'product-card', card_product: recommended, quick_add: section.settings.show_quick_add, show_rating: section.settings.show_rating, discount_badge: section.settings.show_discount %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Passar bra ihop med" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "carousel", "label": "Carousel" }
    ]},
    { "type": "range", "id": "limit", "label": "Products to fetch", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "per_row", "label": "Columns / items visible on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "header", "content": "Product cards" },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add (+ Add)", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount as \"Save X%\"", "default": true }
  ]
}
{% endschema %}
