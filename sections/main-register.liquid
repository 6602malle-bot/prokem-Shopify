<section class="page-width section auth">
  <div class="auth__box">
    <h1 class="page__title">{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span>{{ 'customer.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span>{{ 'customer.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label class="field"><span>{{ 'customer.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--block">{{ 'customer.register' | t }}</button>
    {%- endform -%}
    <p class="auth__alt">{{ 'customer.have_account' | t }} <a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a></p>
  </div>
</section>

{% schema %}
{ "name": "Register" }
{% endschema %}
