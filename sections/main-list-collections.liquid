<section class="page-width section">
  {% render 'breadcrumbs' %}
  <h1 class="section__title">{{ 'collection.all_collections' | t }}</h1>
  <div class="grid tiles tiles--card" style="--cols-d: {{ section.settings.columns }}; --cols-m: 2; margin-top: 24px">
    {%- for collection in collections -%}
      <a class="tile" href="{{ collection.url }}">
        <span class="tile__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </span>
        <span class="tile__title">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list page",
  "settings": [
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
