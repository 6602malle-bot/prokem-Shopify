<section class="section{% if section.settings.bg == 'alt' %} section--alt{% elsif section.settings.bg == 'dark' %} section--dark{% elsif section.settings.bg == 'custom' %} seo--custom{% endif %}"{% if section.settings.bg == 'custom' %} style="--seo-bg: {{ section.settings.custom_bg }}; --seo-text: {{ section.settings.custom_text_color }};"{% endif %}>
  <div class="page-width">
    <div class="seo rte{% if section.settings.collapse %} product__desc-wrap{% endif %}"{% if section.settings.collapse %} data-readmore data-more-text="{{ 'products.read_more' | t | escape }}" data-less-text="{{ 'products.read_less' | t | escape }}"{% endif %}>
      <div class="product__desc">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {{ section.settings.text }}
      </div>
      {%- if section.settings.collapse -%}
        <button type="button" class="product__desc-toggle" data-readmore-btn>{{ 'products.read_more' | t }}</button>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text block",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bilvårdsprodukter för dig som bryr dig om resultatet" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Berätta om ditt varumärke här: vad som gör produkterna annorlunda, hur de testas och vilka som använder dem. Länka gärna till era viktigaste kategorier och produkter för att hjälpa både kunder och sökmotorer.</p>" },
    { "type": "select", "id": "bg", "label": "Background", "default": "standard", "options": [
      { "value": "standard", "label": "Standard" },
      { "value": "alt", "label": "Alternate (light grey)" },
      { "value": "dark", "label": "Dark" },
      { "value": "custom", "label": "Custom color" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Custom background color", "default": "#f4f4f2" },
    { "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#161616" },
    { "type": "checkbox", "id": "collapse", "label": "Show only part of the text, with a \"Read more\" link", "default": false }
  ],
  "presets": [{ "name": "Text block" }]
}
{% endschema %}
