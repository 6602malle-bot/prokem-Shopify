<div class="announcement" style="--ann-bg: {{ section.settings.bg }}; --ann-text: {{ section.settings.text }};">
  <div class="page-width announcement__inner">
    <ul class="announcement__usps">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <li {{ block.shopify_attributes }}>{% render block %}</li>
        {%- else -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
      <ul class="announcement__links">
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Utility links (e.g. Retailers, Contact)", "info": "Shown on the right on desktop." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Fraktfritt över 1 200 kr" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "usp" }, { "type": "usp" }]
    }
  ]
}
{% endschema %}
