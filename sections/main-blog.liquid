<section class="page-width section">
  {% render 'breadcrumbs' %}
  <h1 class="section__title">{{ blog.title }}</h1>
  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="grid" style="--cols-d: {{ section.settings.columns }}; --cols-m: 2; margin-top: 24px">
      {%- for article in blog.articles -%}
        {% render 'article-card', article: article, show_excerpt: true %}
      {%- else -%}
        <p class="empty">{{ 'blog.no_articles' | t }}</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Blog page",
  "settings": [
    { "type": "range", "id": "posts_per_page", "label": "Posts per page", "min": 6, "max": 30, "step": 3, "default": 12 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
