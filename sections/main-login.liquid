<section class="page-width section auth">
  <div class="auth__box" id="login">
    <h1 class="page__title">{{ 'customer.login' | t }}</h1>
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span>{{ 'customer.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="current-password" required></label>
      <p><a href="#recover" data-recover-toggle>{{ 'customer.forgot' | t }}</a></p>
      <button type="submit" class="btn btn--block">{{ 'customer.login' | t }}</button>
    {%- endform -%}
    <p class="auth__alt">{{ 'customer.no_account' | t }} <a href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a></p>
  </div>

  <div class="auth__box" id="recover" hidden>
    <h2 class="page__title">{{ 'customer.reset' | t }}</h2>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'customer.reset_sent' | t }}</p>{%- endif -%}
      <label class="field"><span>{{ 'customer.email' | t }}</span><input type="email" name="email" autocomplete="email" required></label>
      <button type="submit" class="btn btn--block">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
    <p class="auth__alt"><a href="#login" data-recover-toggle>{{ 'customer.back_to_login' | t }}</a></p>
  </div>
</section>

{% schema %}
{ "name": "Login" }
{% endschema %}
