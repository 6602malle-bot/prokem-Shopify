{%- assign product = section.settings.product -%}
<section class="spotlight">
  <div class="page-width spotlight__inner">
    <div class="spotlight__media">
      {%- if product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 45vw, 90vw', alt: product.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="spotlight__body">
      {%- if section.settings.badge != blank -%}<span class="badge badge--accent">{{ section.settings.badge }}</span>{%- endif -%}
      <h2 class="spotlight__title">{{ section.settings.title | default: product.title | default: 'Produkt' }}</h2>
      {%- if section.settings.tagline != blank -%}<p class="spotlight__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
      <div class="spotlight__text">{{ section.settings.text | default: product.description | strip_html | truncate: 260 }}</div>
      {%- if product != blank -%}
        <div class="spotlight__price">
          <span class="spotlight__now">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
        </div>
        <a class="btn" href="{{ product.url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "badge", "label": "Badge" },
    { "type": "text", "id": "title", "label": "Title override" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "May the gloss be with you ®" },
    { "type": "textarea", "id": "text", "label": "Text override", "info": "Defaults to the product description." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Köp nu" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
